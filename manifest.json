{
  "manifest_version": 3,
  "name": "Close Search Tabs",
  "description": "Closes all search engine tabs with one click or Ctrl+Shift+Z. Supports Google, DuckDuckGo, Bing, Yahoo, Brave, Ecosia, Startpage, Kagi, and more.",
  "short_name": "SearchBGon",
  "author": "Tai Groot",
  "version": "3.2.0",
  "action": {
    "default_icon": "static/icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "commands": {
    "close-search-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "Close all search engine tabs"
    }
  },
  "icons": {
    "16": "static/icon-16.png",
    "32": "static/icon-32.png",
    "48": "static/icon-48.png",
    "64": "static/icon-64.png",
    "128": "static/icon-128.png"
  }
}
